{
    "name": "edusmart/erp",
    "description": "EDUSMART ERP - multi-tenant SaaS platform for school administration (Phase 1 foundation)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-mysqli": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "selftest": "php scripts/selftest.php",
        "migrate": "php scripts/migrate.php core",
        "seed": "php scripts/seed_demo.php"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
